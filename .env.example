# =============================================================================
# Avanti — environment variables
# =============================================================================
# Copy this file to .env.local and fill in as you provision services.
# The app boots without any of these; features light up as you fill them in.
#
# See docs/setup.md for the recommended order to provision services.
# =============================================================================

# -----------------------------------------------------------------------------
# App
# -----------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# -----------------------------------------------------------------------------
# Supabase — https://supabase.com
# Project Settings → API → copy Project URL, anon public, service_role.
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role BYPASSES RLS. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# -----------------------------------------------------------------------------
# Paystack — https://paystack.com (Nigeria launch market)
# Dashboard → Settings → API Keys & Webhooks.
# -----------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Twilio — https://twilio.com  (SMS OTP + notifications)
# Twilio Verify is used for OTP so we don't handle raw codes.
# For markets where a local aggregator wins, we swap via Supabase Auth Hook.
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# -----------------------------------------------------------------------------
# Resend — https://resend.com  (transactional email)
# Verify a sending domain first (DNS records).
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@avanti.example

# -----------------------------------------------------------------------------
# Cloudflare Turnstile — https://cloudflare.com/products/turnstile
# CAPTCHA on signup + password reset per Phase 4 §15.3.
# -----------------------------------------------------------------------------
TURNSTILE_SECRET_KEY=
